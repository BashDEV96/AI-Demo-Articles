# Copy this file to .env and fill it in.

# Your site, no trailing slash
WP_URL=http://localhost
# Your WordPress username
WP_USER=admin
# From Users > Profile > Application Passwords (spaces are fine)
WP_APP_PASSWORD=**** **** **** **** **** ****

# google, openrouter, or openai
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-*******
# Model name for that provider. Check the provider's model list, names change often.
# google example: gemini-2.5-flash
# openrouter example: pick one from openrouter.ai/models (free ones end in :free)
AI_MODEL=Enter_Your_Model_Name_Here
